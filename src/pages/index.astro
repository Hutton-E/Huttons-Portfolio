---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageRoutes } from '../data/routes';
---
<BaseLayout title="Hutton Edney — CS Portfolio" pageKey="home">
	<header class="home-heading"><h1>Hutton Edney</h1></header>
	<nav class="menu-panel page-nav" aria-label="Portfolio pages">
		{pageRoutes.map((route) => (
			<a class="page-nav__link" href={`/${route.slug}/`}>
				<span>{route.title}</span>
				<span class="page-nav__arrow" aria-hidden="true">→</span>
			</a>
		))}
	</nav>
</BaseLayout>